CREATE TABLE task (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    user_name TEXT NOT NULL,
    url TEXT NOT NULL,
    sanity_level INTEGER,
    illust_id INTEGER NOT NULL,
    user_id INTEGER NOT NULL,
    status INTEGER NOT NULL,
    file_name TEXT NOT NULL,
    medium TEXT
);

CREATE INDEX IF NOT EXISTS idx_task_status_id ON task(status, id);
CREATE INDEX IF NOT EXISTS idx_task_url ON task(url);

selectAll:
SELECT * FROM task ORDER BY id ASC;

selectByUrl:
SELECT * FROM task WHERE url = ?;

selectAllPagedAsc:
SELECT * FROM task
ORDER BY id ASC
LIMIT ? OFFSET ?;

selectAllPagedDesc:
SELECT * FROM task
ORDER BY id DESC
LIMIT ? OFFSET ?;

selectByStatusPagedAsc:
SELECT * FROM task
WHERE status = ?
ORDER BY id ASC
LIMIT ? OFFSET ?;

selectByStatusPagedDesc:
SELECT * FROM task
WHERE status = ?
ORDER BY id DESC
LIMIT ? OFFSET ?;

insertOrReplace:
INSERT OR REPLACE INTO task (
    id, title, user_name, url, sanity_level, illust_id, user_id, status, file_name, medium
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM task WHERE id = ?;

deleteAll:
DELETE FROM task;

lastInsertRowId:
SELECT last_insert_rowid();

-- 启动对账：进程崩溃后任务行会永久停在 Downloading，这里统一落到失败终态。
-- 状态数值与 DownloadHistoryRepository 的映射一致（Pending=0、Downloading=1、Success=2、Failed=3）；
-- 只匹配 Downloading —— Pending 表示排队待下、Success/Failed 已是终态，都不应被改写。
markInterrupted:
UPDATE task
SET status = 3
WHERE status = 1;
