CREATE TABLE glanceillustpersist (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    illust_id INTEGER NOT NULL,
    user_id INTEGER NOT NULL,
    picture_url TEXT NOT NULL,
    title TEXT,
    user_name TEXT,
    ctype TEXT NOT NULL,
    original_url TEXT,
    large_url TEXT,
    ctime INTEGER NOT NULL
);

selectAll:
SELECT * FROM glanceillustpersist ORDER BY ctime;

selectByIllustId:
SELECT * FROM glanceillustpersist WHERE illust_id = ?;

selectByType:
-- 按 ctime 倒序取最新缓存行（调用方 firstOrNull 即最新数据，而非旧实现的最旧行）。
SELECT * FROM glanceillustpersist WHERE ctype = ? ORDER BY ctime DESC;

deleteByType:
DELETE FROM glanceillustpersist WHERE ctype = ?;

searchByTitleOrUserName:
SELECT * FROM glanceillustpersist
WHERE title LIKE ? OR user_name LIKE ?
ORDER BY ctime;

insertOrReplace:
INSERT OR REPLACE INTO glanceillustpersist (
    id, illust_id, user_id, picture_url, title, user_name, ctype, original_url, large_url, ctime
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteByIllustId:
DELETE FROM glanceillustpersist WHERE illust_id = ?;

deleteAll:
DELETE FROM glanceillustpersist;
